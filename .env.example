# Copy to .env for local runs (npm start reads it), or set these on Render.
# Mail option 1: any SMTP provider, any sender address (wins if set)
# SMTP_URL=smtps://user:pass@smtp-relay.brevo.com:465
# MAIL_FROM=Hackathon-bud <hello@yourdomain.in>
# Mail option 2: a Gmail account, which is also the sender
GMAIL_USER=you@gmail.com
# App password from https://myaccount.google.com/apppasswords, 16 letters, no spaces
GMAIL_APP_PASSWORD=
# Optional: Postgres for subscribers; without it they live in .data/store.json
# DATABASE_URL=postgres://...
# Optional: lets an outside pinger run the daily jobs via /api/cron?key=...
# CRON_SECRET=some-long-random-string
# Optional: the public address used in email links (Render sets RENDER_EXTERNAL_URL itself)
# PUBLIC_URL=https://hackathon-bud.onrender.com/
